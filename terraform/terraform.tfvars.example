```hcl
aws_region             = "eu-central-1"
aws_vpc                = "10.0.0.0/16"
aws_private_subnet_a   = "10.0.1.0/24"
aws_private_subnet_b   = "10.0.2.0/24"
aws_public_subnet_a    = "10.0.3.0/24"
aws_public_subnet_b    = "10.0.4.0/24"

eks_cluster_name       = "minicloud-eks"
eks_cluster_version    = "1.35"
public_access_cidrs    = ["YOUR_PUBLIC_IP/32"]

eks_node_instance_type = ["t3.medium"]
eks_node_desired_size  = 1
eks_node_min_size      = 1
eks_node_max_size      = 2

# Replace with the ARN of your IAM user
eks_admin_principal_arn = "arn:aws:iam::123456789012:user/your-iam-user"
```